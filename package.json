{
  "name": "yext-standard-library",
  "version": "0.0.0",
  "description": "A Yext Pages Section Library containing the original 'out-of-the-box' sections.",
  "author": "sprumo@yext.com",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "SECTION_LIBRARY_REVISION_ID=local pages dev",
    "prod": "pages prod",
    "build": "pages build",
    "i18n:prepare": "yextve i18n prepare",
    "i18n:finalize": "yextve i18n finalize",
    "lint": "oxlint --react-plugin --deny-warnings .",
    "lint:fix": "oxlint --fix --react-plugin --deny-warnings .",
    "prettier": "prettier --write --cache .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run ./src/testing/*.test.tsx",
    "test:components": "SECTION_LIBRARY_REVISION_ID=local vitest run ./src/testing/*.test.tsx",
    "generate-notices": "generate-license-file --input package.json --output ./THIRD-PARTY-NOTICES --overwrite",
    "validate": "yextve validate",
    "deploy": "yextve deploy",
    "convert-template": "yextve convert-template --apply --delete-source",
    "add-directory-locator": "yextve add-directory-locator"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "dependencies": {
    "@puckeditor/core": "0.22.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@yext/search-headless-react": "^2.7.1",
    "@yext/search-ui-react": "^3.4.1",
    "awesome-phonenumber": "^7.8.0",
    "lucide-react": "^0.414.0",
    "mapbox-gl": "^3.20.0",
    "pure-react-carousel": "^1.35.0",
    "react": "^18.2.0",
    "react-collapsed": "^4.1.2",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.2.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@radix-ui/react-toggle": "^1.1.18",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^3.2.4",
    "@yext/pages": "1.3.4",
    "@yext/pages-components": "2.2.0",
    "@yext/visual-editor": "2.0.0-beta.4",
    "autoprefixer": "^10.4.8",
    "generate-license-file": "^3.6.0",
    "i18next": "^26.4.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.1.1",
    "oxlint": "1.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
